{
  "name": "nextjs-personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website for John Xanthopoulos - Next.js migration from Gatsby",
  "author": "John Xanthopoulos",
  "homepage": "https://synepho.com",
  "scripts": {
    "dev": "next dev",
    "build": "env -u NODE_ENV next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry-run": "./scripts/deploy.sh --dry-run",
    "invalidate": "./scripts/deploy.sh --invalidate-only",
    "prepare": "husky"
  },
  "dependencies": {
    "marked": "^18.2.1",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.7.0",
    "daisyui": "^4.12.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.20",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.16",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "^3.15.2",
    "postcss": "^8.5.20",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-uri": "^3.1.9",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "postcss-selector-parser@6": "^6.1.5",
    "source-map-js": "^1.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
