{
  "name": "nextjs-personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website for John Xanthopoulos - Next.js migration from Gatsby",
  "author": "John Xanthopoulos",
  "homepage": "https://synepho.com",
  "scripts": {
    "dev": "next dev",
    "build": "env -u NODE_ENV next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry-run": "./scripts/deploy.sh --dry-run",
    "invalidate": "./scripts/deploy.sh --invalidate-only",
    "prepare": "husky"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^16.4.2",
    "next": "^15.5.22",
    "next-sitemap": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "daisyui": "^4.12.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.20",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "js-yaml": "^3.15.0",
    "postcss": "^8.5.20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
